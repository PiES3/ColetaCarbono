SECRET_KEY=change-me
DATABASE_URL=sqlite:///./carbono.db
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=15
CONFIRM_TOKEN_EXPIRE_MINUTES=1440
